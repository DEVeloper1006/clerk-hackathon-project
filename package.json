{
  "name": "clerk",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @clerk/shared build && pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "eslint . && prettier --check .",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "seed:elastic": "tsx --env-file=.env infra/scripts/seed-elastic.ts",
    "seed:demo": "tsx --env-file=.env infra/scripts/seed-demo.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@elastic/elasticsearch": "^8.17.0",
    "drizzle-orm": "^0.38.3",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "pg": "^8.13.1",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vitest": "^2.1.8"
  }
}
