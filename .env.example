# ─── Runtime ────────────────────────────────────────────────
NODE_ENV=development            # development | production | test
PORT=3001                       # API server port
CORS_ORIGIN=http://localhost:5173  # Allowed origin for the web dashboard

# ─── Data stores ────────────────────────────────────────────
DATABASE_URL=postgres://clerk:clerk@localhost:5432/clerk   # Postgres connection string
REDIS_URL=redis://localhost:6379                           # Redis connection string (event bus)
ELASTICSEARCH_URL=http://localhost:9200                    # Elasticsearch endpoint

# ─── PayPal (sandbox only) ──────────────────────────────────
PAYPAL_CLIENT_ID=               # PayPal sandbox app client ID
PAYPAL_CLIENT_SECRET=           # PayPal sandbox app secret
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com  # PayPal REST base URL
PAYPAL_REDIRECT_URI=http://localhost:3001/api/paypal/callback  # OAuth callback

# ─── AI ─────────────────────────────────────────────────────
LLM_PROVIDER=openai             # openai | anthropic
OPENAI_API_KEY=                 # LLM provider key
OPENAI_MODEL=gpt-4o-mini        # Model used by agents

# ─── Auth ───────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string  # Auth token signing (min 16 chars)

# ─── Sponsor integrations ───────────────────────────────────
CHANNEL3_API_KEY=               # Channel3 product catalog
KERNEL_API_KEY=                 # KERNEL browser-as-a-service
ZAPIER_WEBHOOK_URL=             # Zapier trigger endpoint

# ─── Infra (Render API) ─────────────────────────────────────
RENDER_API_KEY=                 # Render API key (Account Settings → API Keys)
RENDER_OWNER_ID=                # Render workspace/owner id that tenant resources are created under
SECRETS_ENCRYPTION_KEY=         # 32 random bytes, base64 (openssl rand -base64 32) — encrypts tenant secrets

# ─── Web (Vite exposes VITE_* to the browser) ───────────────
VITE_API_URL=http://localhost:3001  # API base URL for the dashboard
